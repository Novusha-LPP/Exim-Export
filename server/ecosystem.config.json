{
  "apps": [
    {
      "name": "exim-api",
      "script": "app.js",
      "instances": "max",
      "exec_mode": "cluster",
      "max_memory_restart": "1G",
      "env": {
        "NODE_ENV": "production",
        "ENABLE_IN_PROCESS_CRON": "false"
      }
    },
    {
      "name": "exim-worker",
      "script": "worker.mjs",
      "instances": 1,
      "exec_mode": "fork",
      "max_memory_restart": "1G",
      "env": {
        "NODE_ENV": "production"
      }
    }
  ]
}
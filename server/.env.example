# Server Environment Variables Template
# Copy this file to .env for local development

PORT=9002
NODE_ENV=development
USE_NORMALIZED_SUBCOLLECTIONS=true

# ImpexCube Integration
IMEXCUBE_BASE_URL=https://impexapi.impexcube.in
IMPEX_USERNAME=your_impex_username
IMPEXCUBE_USERNAME=your_impex_username
IMPEX_PASSWORD=your_impex_password
IMPEXCUBE_PASSWORD=your_impex_password
COMPANY_BR_CODE_AMD=5E8D2587-A7BA-49A2-B836-21C70B2AAF47
COMPANY_BR_CODE_GIM=8677A8AA-D338-4413-8CCD-48DB23D28EBD
COMPANY_BR_CODE_COK=F9BB73B5-C772-4474-866B-C8B2790B7448
IMPEXCUBE_COMPANY_BR_CODE=5E8D2587-A7BA-49A2-B836-21C70B2AAF47
FYEAR=2026-2027
IMPEXCUBE_FYEAR=2026-2027
IMPEXCUBE_SENDER_ID=RAJANSFPL

# Database URIs
DEV_MONGODB_URI=mongodb://localhost:27017/export
SERVER_MONGODB_URI=mongodb://localhost:27017/export
PROD_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/export
SERVER_CLIENT_URI=http://exim-export.s3-website.ap-south-1.amazonaws.com

IMPORT_MONGODB_URI_SERVER=mongodb://localhost:27017/exim
IMPORT_MONGODB_URI_PROD=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/exim
IMPORT_MONGODB_URI_DEV=mongodb://localhost:27017/exim

# Digital Signature Certificate (DSC) Signing Server
SIGNING_SERVER_URL=http://localhost:50002

# Cryptographic JWT Authentication
JWT_SECRET=replace_with_a_secure_random_64_char_string
JWT_EXPIRATION=24h
JWT_REFRESH_SECRET=replace_with_a_secure_random_64_char_string
STRICT_JWT=false

# AWS S3 Storage
REACT_APP_S3_BUCKET=exim-images-p1
REACT_APP_ACCESS_KEY=your_aws_access_key_id
REACT_APP_SECRET_ACCESS_KEY=your_aws_secret_access_key
REACT_APP_AWS_REGION=ap-south-1

# SMTP Email Configuration (Alerts, DSR reports)
SMTP_HOST=smtp.mailer91.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=emailer@mail.novusha.com
SMTP_PASS=your_smtp_password

# MSG91 Email API Configuration
MSG91_AUTHKEY=your_msg91_authkey
MSG91_DOMAIN=mail.novusha.com
MSG91_FROM_EMAIL=no-reply@mail.novusha.com

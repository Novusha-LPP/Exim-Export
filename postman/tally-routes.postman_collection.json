								"key": "x-api-key",
								"value": "{{api_key}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"job_no\": \"AMD/EXP/SEA/00302/26-27\",\n    \"agency_bill_no\": \"GEA/0863/26-27\",\n    \"agency_bill_date\": \"2026-05-04\",\n    \"agency_bill_amount\": 15000,\n    \"agency_bill_doc\": \"https://example.com/docs/agency_bill_0863.pdf\",\n    \"reimbursement_bill_no\": \"GER/0863/26-27\",\n    \"reimbursement_bill_date\": \"2026-05-04\",\n    \"reimbursement_bill_amount\": 4500,\n    \"reimbursement_bill_doc\": \"https://example.com/docs/reimb_bill_0863.pdf\"\n}"

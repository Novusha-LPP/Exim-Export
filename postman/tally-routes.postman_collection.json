								"{{base_url}}"
							],
							"path": [
								"api",
								"tally",
								"billing-details"
							]
						},
						"description": "Push/Update billing numbers, dates, amounts, and documents from Tally for an Export job using POST. Also updates all child jobs if target is a club job parent."

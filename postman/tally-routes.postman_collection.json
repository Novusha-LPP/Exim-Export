{
	"info": {
		"_postman_id": "c1f7b8d4-5a6b-4e8c-9d1e-2f3a4b5c6d7e",
		"name": "Tally Integration API Collection (Import & Export)",
		"description": "Complete API collection for Tally integration with Exim system. Supports both Import & Export projects, including Job Data retrieval, Sequence Generation, Purchase Book Entries, Payment Requests, and Billing Details push sync endpoint using POST.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "01. Connection Test",
			"item": [
				{
					"name": "Test Tally Connection",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/tally/test",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"tally",
								"test"
							]
						},
						"description": "Check if the Tally API server is online and responding."
					},
					"response": []
				}
			]
		},
		{
			"name": "02. Job Data (Export & Import)",
			"item": [
				{
					"name": "Get Export Job Data",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "x-api-key",
								"value": "{{api_key}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/tally/job-data?job_number=AMD/EXP/SEA/00302/26-27",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"tally",
								"job-data"
							],
							"query": [
								{
									"key": "job_number",
									"value": "AMD/EXP/SEA/00302/26-27",
									"description": "Export job number (full format or short bill ref e.g. GEA/0863/26-27)"
								},
								{
									"key": "freight",
									"value": "false",
									"description": "Optional: Override freight job flag (true/false)",
									"disabled": true
								}
							]
						},
						"description": "Retrieve formatted Export job and invoice details for Tally integration (supports single or clubbed jobs)."
					},
					"response": []
				},
				{
					"name": "Get Import Job Data",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "x-api-key",
								"value": "{{api_key}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/tally/job-data?job_number=AMD/IMP/SEA/00100/26-27",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"tally",
								"job-data"
							],
							"query": [
								{
									"key": "job_number",
									"value": "AMD/IMP/SEA/00100/26-27",
									"description": "Import job number (full format or short bill ref e.g. GIA/00001/26-27)"
								}
							]
						},
						"description": "Retrieve formatted Import job details for Tally integration."
					},
					"response": []
				},
				{
					"name": "Get Job Data by Specific Invoice",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "x-api-key",
								"value": "{{api_key}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/tally/job-data?job_number=AMD/EXP/SEA/00302/26-27&invoice_number=EIN26-27/00092",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"tally",
								"job-data"
							],
							"query": [
								{
									"key": "job_number",
									"value": "AMD/EXP/SEA/00302/26-27",
									"description": "The job number"
								},
								{
									"key": "invoice_number",
									"value": "EIN26-27/00092",
									"description": "Specific invoice number to filter"
								}
							]
						},
						"description": "Retrieve job data filtered for a specific invoice number."
					},
					"response": []
				}
			]
		},
		{
			"name": "03. Sequence Generator",
			"item": [
				{
					"name": "Get Next Sequence - Purchase Entry",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "x-api-key",
								"value": "{{api_key}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/tally/next-sequence?type=purchase&jobNo=AMD/EXP/SEA/00302/26-27",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"tally",
								"next-sequence"
							],
							"query": [
								{
									"key": "type",
									"value": "purchase",
									"description": "Sequence type: 'purchase'"
								},
								{
									"key": "jobNo",
									"value": "AMD/EXP/SEA/00302/26-27",
									"description": "Job number to generate PB sequence for"
								}
							]
						},
						"description": "Retrieve the next incremented sequence number for a Purchase Book entry (returns prefix PB/01/...)."
					},
					"response": []
				},
				{
					"name": "Get Next Sequence - Payment Request",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "x-api-key",
								"value": "{{api_key}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/tally/next-sequence?type=payment&jobNo=AMD/EXP/SEA/00302/26-27",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"tally",
								"next-sequence"
							],
							"query": [
								{
									"key": "type",
									"value": "payment",
									"description": "Sequence type: 'payment'"
								},
								{
									"key": "jobNo",
									"value": "AMD/EXP/SEA/00302/26-27",
									"description": "Job number to generate R1 sequence for"
								}
							]
						},
						"description": "Retrieve the next incremented sequence number for a Payment Request (returns prefix R1/01/...)."
					},
					"response": []
				}
			]
		},
		{
			"name": "04. Purchase Book Entry",
			"item": [
				{
					"name": "Create Purchase Entry",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "x-api-key",
								"value": "{{api_key}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"Entry No\": \"PB/01/AMD/EXP/SEA/00302/26-27\",\n    \"Entry Date\": \"2026-05-04\",\n    \"Supplier Inv No\": \"INV-12345\",\n    \"Supplier Inv Date\": \"2026-05-01\",\n    \"Job No\": \"AMD/EXP/SEA/00302/26-27\",\n    \"Supplier Name\": \"ABC LOGISTICS PVT LTD\",\n    \"Address 1\": \"123 Port Road\",\n    \"Address 2\": \"Near Customs House\",\n    \"State\": \"Gujarat\",\n    \"Country\": \"India\",\n    \"Pin Code\": \"380009\",\n    \"GSTIN NO\": \"24AAAAA0000A1Z5\",\n    \"PAN\": \"AAAAA0000A\",\n    \"Place of Supply\": \"24-Gujarat\",\n    \"Description of Services\": \"Freight Charges\",\n    \"Charge Heading\": \"Ocean Freight\",\n    \"Charge Head Category\": \"Freight\",\n    \"SAC\": \"996511\",\n    \"Taxable Value\": 10000.00,\n    \"GST%\": 18,\n    \"CGST\": 900.00,\n    \"SGST\": 900.00,\n    \"IGST\": 0.00,\n    \"TDS\": 200.00,\n    \"Total\": 11800.00,\n    \"Net Amount\": 11600.00,\n    \"Status\": \"Pending\",\n    \"isClubJob\": false\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/tally/purchase-entry",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"tally",
								"purchase-entry"
							]
						},
						"description": "Create a new Purchase Book Entry record in the database."
					},
					"response": []
				},
				{
					"name": "Get Purchase Entry Details",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "x-api-key",
								"value": "{{api_key}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/tally/purchase-entry?entry_no=PB/01/AMD/EXP/SEA/00302/26-27",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"tally",
								"purchase-entry"
							],
							"query": [
								{
									"key": "entry_no",
									"value": "PB/01/AMD/EXP/SEA/00302/26-27",
									"description": "The entry number to fetch"
								},
								{
									"key": "freight",
									"value": "true",
									"description": "Optional: Override freight flag",
									"disabled": true
								}
							]
						},
						"description": "Retrieve details of a specific Purchase Book entry enriched with job & TDS calculations."
					},
					"response": []
				}
			]
		},

# Client Environment Variables Template
# Copy this file to .env for local development

# Backend API Endpoint
VITE_API_STRING=http://localhost:9002/api
# Production: https://eximbot.alvision.in/export/api

# Import Module Endpoint
VITE_IMPORT_API_STRING=https://eximbot.alvision.in/import/api

# Client UI Version
VITE_VERSION=12-10-01

# Build and Dev Settings
FAST_REFRESH=false
GENERATE_SOURCEMAP=true

# Third-party Integrations
VITE_TALLY_KEY=your_tally_api_key_here
